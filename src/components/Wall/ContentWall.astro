---
import {
  Plus,
  ArrowUpRight,
  ArrowLeft,
  X,
  CheckCheck,
  LayoutGrid,
  Focus,
  CornerDownLeft,
} from "@lucide/astro";
import Button from "@/components/Button.astro";
import Input from "@/components/Form/Input.astro";
import Heading from "@/components/Typography/Heading.astro";
import ContentWallTask from "./ContentWallTask.astro";
import ContentWallGroup from "./ContentWallGroup.astro";

interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
}
const { render = true } = Astro.props;
---

{
  render && (
    <div class="wall_wrap" data-wall data-mode="board" data-placing="false">
      <div class="wall_workspace">
        <div class="wall_composer-heading">
          <>
            <div class="wall_brand">
              <img src="/thewall.svg" width="20" height="20" alt="" />
              <Heading tag="h1" variant="inherit" class="wall_wordmark">
                theWall<span>.</span>
              </Heading>
            </div>
            <span>LO QUE TIENES EN MENTE</span>
            <span class="wall_pending" data-pending-count>
              0 pendientes
            </span>
          </>
        </div>
        <form class="wall_composer" data-composer>
          <Input
            name="task"
            label="Nueva tarea"
            labelHidden
            placeholder="Una cosa por hacer..."
            maxlength={500}
            autocomplete="off"
            required
            data-composer-input
          />
          <Button
            type="submit"
            class="wall_create"
            aria-label="Crear tarea"
            title="Crear tarea"
          >
            <>
              <Plus />
              <span>Crear</span>
              <CornerDownLeft class="wall_enter" />
            </>
          </Button>
        </form>

        <div class="wall_placement" data-placement hidden>
          <span class="wall_placement-label">ELIGE UN DESTINO</span>
          <div
            class="wall_draft"
            data-draft-list
            data-drop="draft"
            role="list"
            aria-label="Tarea nueva"
          />
          <Button
            class="wall_icon"
            data-action="cancel"
            aria-label="Cancelar colocación"
            title="Cancelar"
          >
            <X />
          </Button>
        </div>

        <section class="wall-focus_wrap" data-focus-zone aria-label="Focus">
          <div class="wall-focus_header">
            <>
              <span class="wall-focus_label">
                <Focus />
                FOCUS
              </span>
              <span class="wall-focus_caption" data-focus-caption>
                Una cosa a la vez.
              </span>
              <Button
                class="wall_icon"
                data-action="exit-focus"
                aria-label="Salir de Focus"
                title="Volver al tablero"
                hidden
              >
                <ArrowLeft />
              </Button>
            </>
          </div>
          <button
            type="button"
            class="wall-focus_target"
            data-action="focus"
            disabled
          >
            <>
              <ArrowUpRight />
              <span>Traer al foco</span>
            </>
          </button>
          <div
            class="wall-focus_list"
            data-focus-list
            data-drop="focus"
            role="list"
            aria-label="Tarea en foco"
          />
          <span class="wall-focus_origin" data-focus-origin hidden />
          <span class="wall-focus_corner" aria-hidden="true" />
        </section>

        <section class="wall_board" data-board aria-label="Tablero de tareas">
          <div class="wall_toolbar">
            <div class="wall_views" role="group" aria-label="Vista de tareas">
              <button type="button" data-action="pending" aria-pressed="true">
                <>
                  <LayoutGrid />
                  <span>Pendientes</span>
                  <span data-total-pending>0</span>
                </>
              </button>
              <button
                type="button"
                data-action="completed"
                aria-pressed="false"
              >
                <>
                  <CheckCheck />
                  <span>Hechas</span>
                  <span data-total-completed>0</span>
                </>
              </button>
            </div>
            <Button class="wall_add-group" data-action="add-group">
              <>
                <Plus />
                <span>Nuevo grupo</span>
              </>
            </Button>
          </div>
          <div class="wall_groups" data-groups />
          <div class="wall_no-groups" data-no-groups hidden>
            <>
              <img src="/thewall.svg" width="64" height="64" alt="" />
              <p>Un espacio en blanco.</p>
              <Button class="wall_add-group" data-action="add-group">
                <>
                  <Plus />
                  <span>Crear un grupo</span>
                </>
              </Button>
            </>
          </div>
        </section>
        <footer class="wall_footer">
          <>
            <span data-footer-count>0 TAREAS EN EL MURO</span>
            <span>
              MENOS RUIDO. M&Aacute;S HECHO.
              <ArrowUpRight />
            </span>
          </>
        </footer>
      </div>

      <p class="wall_warning" role="alert" data-warning hidden />
      <div
        class="wall_toast"
        role="status"
        aria-live="polite"
        data-toast
        hidden
      />
      <p class="sr-only" aria-live="polite" data-announcement />
      <noscript>
        <p class="wall_warning">
          Activa JavaScript para usar el tablero y guardar tus tareas.
        </p>
      </noscript>

      <dialog
        class="wall-dialog_wrap"
        data-dialog
        aria-labelledby="wall-dialog-title"
      >
        <form data-dialog-form>
          <div class="wall-dialog_header">
            <>
              <Heading tag="h2" variant="inherit" id="wall-dialog-title">
                Nueva tarea
              </Heading>
              <Button
                class="wall_icon"
                data-action="close-dialog"
                aria-label="Cerrar"
                title="Cerrar"
              >
                <X />
              </Button>
            </>
          </div>
          <Input
            name="text"
            label="Texto"
            maxlength={500}
            required
            autocomplete="off"
            data-dialog-input
          />
          <p class="wall-dialog_error" data-dialog-error role="alert" hidden />
          <div class="wall-dialog_actions">
            <>
              <Button class="wall_secondary" data-action="close-dialog">
                Cancelar
              </Button>
              <Button class="wall_primary" type="submit" data-dialog-submit>
                Guardar
                <ArrowUpRight />
              </Button>
            </>
          </div>
        </form>
      </dialog>
      <template data-task-template>
        <ContentWallTask />
      </template>
      <template data-group-template>
        <ContentWallGroup />
      </template>
    </div>
  )
}

<script>
  import { mountWall } from "./controller.ts";
  document.querySelectorAll<HTMLElement>("[data-wall]").forEach(mountWall);
</script>

<style is:global>
  @layer components {
    .wall_wrap {
      --wall-paper: #f5f8fc;
      --wall-ink: #171918;
      --wall-primary: #5f7ea3;
      --wall-primary-ink: #0b0d10;
      --wall-secondary: #ec3c29;
      --wall-blue-soft: #e5edf7;
      --wall-muted: #6f7782;
      --wall-line: #d6dfe9;
      --text: var(--wall-ink);
      --background: var(--wall-paper);
      --text-main: 1rem;
      --text-small: 0.875rem;
      --letter-spacing-tight: 0;
      --radius-main: 0.125rem;
      color: var(--wall-ink);
      background: var(--wall-paper);
      min-height: 100dvh;
      padding: 0 3.5rem;
      font-size: 1rem;
      letter-spacing: 0;
      & [hidden] {
        display: none !important;
      }
      & button {
        letter-spacing: 0;
      }
      & button:focus-visible,
      & input:focus-visible {
        outline: 0.1875rem solid var(--wall-primary);
        outline-offset: 0.1875rem;
      }
      & .button_text {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }
      & .button_text::before,
      & .button_text::after {
        display: none;
      }
      & .button_wrap {
        border-radius: 0.125rem;
        font-size: 0.875rem;
        letter-spacing: 0;
      }
      & .field-control {
        font-size: 1rem;
        letter-spacing: 0;
      }
      & svg {
        stroke-width: 1.7;
      }
      &[data-placing="true"] .wall_brand,
      &[data-placing="true"] .wall_footer {
        filter: blur(0.15rem);
        opacity: 0.55;
      }
      &[data-placing="true"]
        .wall-task_wrap:not(.is-selected):not(.is-draft):not(.sortable-fallback)
        .wall-task_body {
        filter: blur(0.1rem);
        opacity: 0.45;
      }
      &[data-mode="placing-new"] .wall_composer {
        opacity: 0.55;
      }
      &[data-mode="focused"] .wall_composer-heading,
      &[data-mode="focused"] .wall_composer {
        display: none;
      }
      &[data-mode="focused"] .wall_workspace {
        padding-top: 1.5rem;
      }
      &[data-mode="focused"] .wall_footer {
        display: none;
      }
      &[data-mode="focused"] .wall-focus_wrap {
        min-height: max(26rem, calc(100dvh - 3rem));
        background: var(--wall-blue-soft);
        margin-bottom: 0;
      }
      &[data-mode="focused"] .wall-focus_list {
        display: flex;
        justify-content: center;
        align-items: center;
        flex: 1;
        min-height: 18rem;
        padding: 2rem;
      }
      &[data-mode="focused"] .wall-focus_list > .wall-task_wrap {
        max-width: 36rem;
      }
      &[data-mode="focused"] .wall-focus_list .wall-task_body {
        min-height: 10rem;
        box-shadow: 0.5rem 0.5rem 0 var(--wall-ink);
      }
      &[data-mode="focused"] .wall-focus_list .wall-task_select {
        font-size: 1.4rem;
      }
      &[data-focus-eligible="true"] .wall-focus_wrap {
        min-height: 12rem;
        border-style: dashed;
        border-color: var(--wall-ink);
        background: var(--wall-blue-soft);
      }
      &[data-focus-eligible="true"] .wall-focus_target {
        display: flex;
      }
      &[data-focus-eligible="true"] .wall-focus_list {
        position: absolute;
        inset: 3rem 0 0;
        min-height: 8rem;
        padding-inline: 1rem;
      }
      &[data-focus-eligible="true"] .wall-focus_list > .wall-task_wrap {
        max-width: 36rem;
        margin-inline: auto;
      }
      &[data-mode="placing-new"] .wall-focus_wrap {
        opacity: 0.35;
      }
      @media (width < 48rem) {
        padding-inline: 1.25rem;
        & .wall_workspace {
          padding-top: 1.75rem;
        }
        & .wall_composer .field-control {
          font-size: 1.125rem;
        }
        & .wall_create.button_wrap {
          width: 4rem;
          padding: 0.75rem;
        }
        & .wall_create .button_text > span,
        & .wall_enter {
          display: none;
        }
        & .wall_groups {
          grid-template-columns: minmax(0, 1fr);
          --group-spacing: 1.25rem;
          & > .wall-group_wrap:nth-child(n) {
            grid-column: 1;
          }
        }
        & .wall_composer-heading {
          font-size: 0.6rem;
          gap: 0.5rem;
        }
        & .wall_toolbar {
          align-items: flex-start;
          gap: 0.75rem;
        }
        & .wall_views {
          gap: 0.75rem;
        }
        & .wall_views button {
          gap: 0.25rem;
          font-size: 0.75rem;
        }
        & .wall_views svg {
          display: none;
        }
        & .wall_add-group {
          font-size: 0.7rem;
          padding-inline: 0.625rem;
        }
        & .wall-focus_caption {
          font-size: 0.75rem;
        }
        & .wall_footer {
          font-size: 0.55rem;
          gap: 1rem;
        }
        & .wall_placement {
          flex-wrap: wrap;
        }
        & .wall_placement-label {
          font-size: 0.65rem;
        }
        & .wall_draft {
          order: 3;
          flex-basis: 100%;
        }
        & .wall_placement > .wall_icon {
          margin-left: auto;
        }
        &[data-mode="focused"] .wall-focus_list {
          padding: 1rem;
        }
        &[data-mode="focused"] .wall-focus_list .wall-task_select {
          font-size: 1.125rem;
        }
        &[data-mode="focused"] .wall-focus_wrap {
          min-height: max(22rem, calc(100dvh - 3rem));
        }
      }
    }
    .wall_brand {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-shrink: 0;
      transition: filter 180ms, opacity 180ms;
    }
    .wall_brand img {
      width: 1.25rem;
      height: 1.25rem;
      transform: rotate(-7deg);
    }
    .wall_wordmark {
      font-family: Arial, sans-serif;
      font-weight: 900;
      font-size: 1.25rem;
      line-height: 1;
      margin: 0;
      letter-spacing: 0;
      & span {
        color: var(--wall-secondary);
      }
    }
    .wall_workspace {
      max-width: 90rem;
      margin-inline: auto;
      padding-top: 2.5rem;
      padding-bottom: 1.5rem;
    }
    .wall_composer-heading {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 1rem;
      font-family: monospace;
      font-size: 0.7rem;
      margin-bottom: 0.875rem;
    }
    .wall_pending {
      margin-left: auto;
      color: var(--wall-muted);
    }
    .wall_composer {
      display: flex;
      border: 0.125rem solid var(--wall-ink);
      min-height: 5.5rem;
      background: white;
      margin-bottom: 1.5rem;
    }
    .wall_composer .field {
      flex: 1;
      min-width: 0;
      margin: 0;
      display: flex;
    }
    .wall_composer .field-control {
      border: none;
      border-radius: 0;
      width: 100%;
      height: 100%;
      padding: 1rem 1.5rem;
      background: transparent;
      font-size: 1.5rem;
      color: var(--wall-ink);
      box-shadow: none;
    }
    .wall_composer .field-control::placeholder {
      color: #949eab;
    }
    .wall_create.button_wrap {
      width: 10.5rem;
      border: none;
      border-left: 0.125rem solid var(--wall-ink);
      border-radius: 0;
      background: var(--wall-primary);
      color: var(--wall-primary-ink);
      font-weight: 700;
      padding: 1rem;
    }
    .wall_create.button_wrap:hover {
      background: var(--wall-ink);
      color: white;
    }
    .wall_create .button_text {
      gap: 0.75rem;
      & svg {
        width: 1.5rem;
        height: 1.5rem;
      }
      & .wall_enter {
        width: 1rem;
        height: 1rem;
        margin-left: 0.5rem;
        opacity: 0.65;
      }
    }
    .wall_icon.button_wrap {
      width: 2rem;
      height: 2rem;
      min-height: 2rem;
      padding: 0.375rem;
      flex-shrink: 0;
      background: transparent;
      border: 0.0625rem solid transparent;
      color: inherit;
      & svg {
        width: 1rem;
        height: 1rem;
      }
      &:hover:not(:disabled) {
        background: var(--wall-blue-soft);
        color: var(--wall-ink);
      }
      &:disabled {
        opacity: 0.25;
        cursor: not-allowed;
      }
    }
    .wall_wrap .wall-task_check.button_wrap {
      width: 1.75rem;
      height: 1.75rem;
      min-height: 1.75rem;
      border-color: #a6b2c2;
    }
    .wall_placement {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding-block: 0.25rem 1.25rem;
    }
    .wall_placement-label {
      font-size: 0.7rem;
      font-family: monospace;
      color: var(--wall-secondary);
      flex-shrink: 0;
    }
    .wall_draft {
      flex: 1;
      min-width: 0;
      max-width: 38rem;
    }
    .wall_placement > .wall_icon {
      margin-left: auto;
    }
    .wall-focus_wrap {
      position: relative;
      display: flex;
      flex-direction: column;
      min-height: 5.5rem;
      border: 0.0625rem solid var(--wall-line);
      margin-bottom: 2.5rem;
      padding: 1rem 1.25rem;
      overflow: hidden;
      transition:
        min-height 320ms cubic-bezier(0.22, 0.8, 0.25, 1),
        background 250ms;
    }
    .wall-focus_header {
      position: relative;
      z-index: 2;
      display: flex;
      align-items: center;
      gap: 1rem;
      min-height: 3rem;
      pointer-events: none;
      & button {
        pointer-events: auto;
        margin-left: auto;
      }
    }
    .wall-focus_label {
      display: flex;
      align-items: center;
      gap: 0.625rem;
      font-size: 0.75rem;
      font-weight: 700;
      & svg {
        width: 1.25rem;
        height: 1.25rem;
      }
    }
    .wall-focus_caption {
      font-size: 0.8rem;
      color: var(--wall-muted);
    }
    .wall-focus_target {
      display: none;
      position: relative;
      z-index: 2;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
      margin: auto;
      padding: 0.875rem 1.5rem;
      background: transparent;
      border: none;
      font-size: 1.25rem;
      font-weight: 700;
      & svg {
        width: 1.75rem;
        height: 1.75rem;
      }
    }
    .wall-focus_origin {
      margin: 1.5rem auto 0.5rem;
      font-size: 0.7rem;
      color: var(--wall-muted);
    }
    .wall-focus_corner {
      position: absolute;
      right: -0.875rem;
      bottom: -0.875rem;
      width: 3rem;
      height: 3rem;
      border-left: 0.25rem solid var(--wall-line);
      rotate: 45deg;
      pointer-events: none;
    }
    .wall_toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 3rem;
      gap: 1rem;
      margin-bottom: 1.5rem;
    }
    .wall_views {
      display: flex;
      gap: 1.75rem;
      & button {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        border: none;
        border-bottom: 0.125rem solid transparent;
        background: transparent;
        font-size: 0.8rem;
        padding: 0.5rem 0;
        color: var(--wall-muted);
      }
      & button[aria-pressed="true"] {
        color: var(--wall-ink);
        border-color: var(--wall-ink);
      }
      & button > span:last-child {
        font-family: monospace;
        font-size: 0.65rem;
        padding: 0.125rem 0.375rem;
        background: #e8edf4;
        min-width: 1.5rem;
        text-align: center;
      }
      & svg {
        width: 1rem;
        height: 1rem;
      }
    }
    .wall_add-group.button_wrap {
      width: max-content;
      flex-shrink: 0;
      background: transparent;
      border: none;
      color: var(--wall-ink);
      padding: 0.5rem 0.75rem 0.5rem 0.5rem;
      font-size: 0.8rem;
      & svg {
        width: 1.125rem;
        height: 1.125rem;
      }
      &:hover {
        color: var(--wall-secondary);
      }
    }
    .wall_groups {
      --group-spacing: 2rem;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-auto-rows: 0.0625rem;
      grid-auto-flow: row dense;
      align-content: start;
      column-gap: var(--group-spacing);
      padding-top: 0.75rem;
      min-height: 18rem;
      & > .wall-group_wrap {
        margin-bottom: var(--group-spacing);
        &:nth-child(3n + 1) {
          grid-column: 1;
        }
        &:nth-child(3n + 2) {
          grid-column: 2;
        }
        &:nth-child(3n + 3) {
          grid-column: 3;
        }
      }
    }
    .wall_no-groups {
      text-align: center;
      padding: 3rem 0;
      & img {
        margin: 0 auto 1.5rem;
        rotate: -7deg;
      }
      & p {
        font-size: 1.25rem;
      }
      & button {
        margin-top: 1rem;
      }
    }
    .wall_footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.625rem;
      font-family: monospace;
      border-top: 0.0625rem solid var(--wall-line);
      padding-top: 1.5rem;
      margin-top: 2.5rem;
      color: var(--wall-muted);
      & > span:last-child {
        display: flex;
        gap: 0.75rem;
        align-items: center;
      }
      & svg {
        width: 1rem;
        height: 1rem;
      }
    }
    .wall_warning {
      position: sticky;
      bottom: 1rem;
      background: #fff2cc;
      padding: 1rem;
      border: 0.0625rem solid var(--wall-ink);
      font-size: 0.875rem;
      z-index: 15;
    }
    .wall_toast {
      position: fixed;
      bottom: 1.5rem;
      left: 50%;
      translate: -50% 0;
      padding: 0.875rem 1.5rem;
      background: var(--wall-ink);
      color: white;
      font-size: 0.8rem;
      max-width: calc(100% - 2rem);
      width: max-content;
      z-index: 20;
    }
    .wall-dialog_wrap {
      width: min(30rem, calc(100% - 2.5rem));
      border: 0.125rem solid var(--wall-ink);
      border-radius: 0.125rem;
      padding: 1.5rem;
      background: var(--wall-paper);
      color: var(--wall-ink);
      margin: auto;
      box-shadow: 0.5rem 0.5rem 0 color-mix(in srgb, var(--wall-primary) 80%, transparent);
      &::backdrop {
        background: rgb(23 25 24 / 0.2);
        backdrop-filter: blur(0.2rem);
      }
      & .field-control {
        background: white;
        border-radius: 0.125rem;
        border: 0.0625rem solid var(--wall-line);
      }
    }
    .wall-dialog_header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 1.5rem;
      & .heading {
        font-size: 1.5rem;
        font-weight: 700;
        margin: 0;
      }
    }
    .wall-dialog_actions {
      display: flex;
      justify-content: flex-end;
      gap: 0.75rem;
      margin-top: 1.5rem;
    }
    .wall_primary.button_wrap {
      background: var(--wall-primary);
      border-color: var(--wall-ink);
      color: var(--wall-primary-ink);
      & svg {
        width: 1rem;
        height: 1rem;
      }
    }
    .wall_secondary.button_wrap {
      background: transparent;
      border-color: var(--wall-line);
      color: var(--wall-ink);
    }
    .wall-dialog_error {
      margin-top: 0.75rem;
      color: #b42517;
      font-size: 0.875rem;
    }
    @media (prefers-reduced-motion: reduce) {
      .wall_wrap *,
      .wall_wrap *::before,
      .wall_wrap *::after {
        animation: none !important;
        transition: none !important;
        scroll-behavior: auto !important;
      }
    }
  }
</style>
