---
import { Trash, ArrowDownRight, Pencil } from "@lucide/astro";
import Button from "@/components/Button.astro";
import Heading from "@/components/Typography/Heading.astro";
interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
}
const { render = true } = Astro.props;
---

{
  render && (
    <section class="wall-group_wrap" data-group-id="">
      <div class="wall-group_frame" aria-hidden="true">
        <span class="wall-group_edge wall-group_edge-top">
          {Array.from({ length: 48 }, () => <span class="wall-group_stroke" />)}
        </span>
        <span class="wall-group_edge wall-group_edge-right">
          {Array.from({ length: 24 }, () => <span class="wall-group_stroke" />)}
        </span>
        <span class="wall-group_edge wall-group_edge-bottom">
          {Array.from({ length: 48 }, () => <span class="wall-group_stroke" />)}
        </span>
        <span class="wall-group_edge wall-group_edge-left">
          {Array.from({ length: 24 }, () => <span class="wall-group_stroke" />)}
        </span>
      </div>
      <div class="wall-group_header">
        <Heading tag="h2" variant="inherit" class="wall-group_title">
          <span data-group-name />
        </Heading>
        <span class="wall-group_count" data-group-count />
        <Button
          class="wall_icon"
          data-action="edit-group"
          aria-label="Editar nombre del grupo"
          title="Editar nombre del grupo"
        >
          <Pencil />
        </Button>
        <Button
          class="wall_icon wall-group_delete"
          data-action="delete-group"
          aria-label="Borrar grupo"
          title="Borrar grupo"
        >
          <Trash />
        </Button>
      </div>
      <button
        type="button"
        class="wall-group_destination"
        data-action="place"
        hidden
      >
        <>
          <span>Colocar aqu&iacute;</span>
          <ArrowDownRight />
        </>
      </button>
      <div class="wall-group_list" data-drop="group" role="list" />
      <div class="wall-group_empty" data-group-empty>
        <>
          <span class="wall-group_dash" aria-hidden="true" />
          <span>Sin tareas</span>
        </>
      </div>
    </section>
  )
}

<style is:global>
  @layer components {
    .wall-group_wrap {
      --group-accent: var(--wall-red);
      position: relative;
      min-width: 0;
      align-self: start;
      padding-inline: 1rem;
      &:nth-child(3n + 2) {
        --group-accent: var(--wall-ink);
      }
      &:nth-child(3n + 3) {
        --group-accent: #5c8c80;
      }
    }
    .wall-group_frame {
      position: absolute;
      inset: -0.375rem;
      pointer-events: none;
    }
    .wall-group_edge {
      position: absolute;
      display: flex;
      justify-content: flex-start;
      gap: 0;
      & .wall-group_stroke {
        display: block;
        flex: 1 1 0;
        min-width: 0;
        min-height: 0;
        background: var(--group-accent);
        transform: rotate(-28deg);
        transform-origin: center;
        transition: transform 520ms cubic-bezier(0.2, 0.8, 0.2, 1);
      }
    }
    .wall-group_edge-top,
    .wall-group_edge-bottom {
      left: 0;
      right: 0;
      height: 0.1rem;
    }
    .wall-group_edge-top {
      top: 0;
    }
    .wall-group_edge-bottom {
      bottom: 0;
    }
    .wall-group_edge-left,
    .wall-group_edge-right {
      top: 0;
      bottom: 0;
      width: 0.1rem;
      flex-direction: column;
      & .wall-group_stroke {
        flex: 0 0 0.6rem;
      }
      & .wall-group_stroke:last-child {
        flex: 1 1 0;
      }
    }
    .wall-group_edge-left {
      left: 0;
    }
    .wall-group_edge-right {
      right: 0;
    }
    .wall-group_header {
      display: flex;
      gap: 0.625rem;
      align-items: center;
      min-height: 5rem;
    }
    .wall-group_title {
      font-size: 1.125rem;
      font-weight: 700;
      font-family: Arial, sans-serif;
      margin: 0;
      line-height: 1.2;
      flex: 1;
      overflow-wrap: anywhere;
    }
    .wall-group_count {
      font-size: 0.75rem;
      font-family: monospace;
      color: var(--wall-muted);
    }
    .wall-group_list {
      display: flex;
      flex-direction: column;
      gap: 0.875rem;
      min-height: 8rem;
      padding-bottom: 1rem;
    }
    .wall-group_empty {
      position: absolute;
      top: 7rem;
      left: 0;
      right: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
      pointer-events: none;
      color: var(--wall-muted);
      font-size: 0.75rem;
    }
    .wall-group_dash {
      width: 1.5rem;
      height: 0.125rem;
      background: var(--wall-line);
    }
    .wall-group_destination {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      padding: 0.65rem 0.875rem;
      font-size: 0.8rem;
      background: var(--wall-mint);
      border: 0.0625rem dashed var(--wall-ink);
      margin-bottom: 0.75rem;
      & svg {
        width: 1.1rem;
        height: 1.1rem;
      }
    }
    .wall_wrap[data-placing="true"] .wall-group_wrap {
      animation: wall-group-nudge   3s ease-in-out infinite;
      &:nth-child(3n + 2) {
        animation-delay: 0.2s;
      }
      &:nth-child(3n + 3) {
        animation-delay: 0.4s;
      }
    }
    .wall_wrap[data-placing="true"] .wall-group_stroke {
      animation: wall-group-frame-close 2.8s cubic-bezier(0.2, 0.8, 0.2, 1) infinite;
      transform: rotate(0);
    }
    .wall_wrap[data-placing="true"] .wall-group_edge-right .wall-group_stroke {
      animation-delay: 0.08s;
    }
    .wall_wrap[data-placing="true"] .wall-group_edge-bottom .wall-group_stroke {
      animation-delay: 0.16s;
    }
    .wall_wrap[data-placing="true"] .wall-group_edge-left .wall-group_stroke {
      animation-delay: 0.24s;
    }
    .wall_wrap[data-placing="true"] .wall-group_empty {
      top: 10rem;
    }
    @keyframes wall-group-nudge {
      0%,
      100% {
        transform: translateY(0);
      }
      12%,
      28% {
        transform: translateY(-0.25rem);
      }
      20%,
      36% {
        transform: translateY(0);
      }
    }
    @keyframes wall-group-frame-close {
      0%,
      18%,
      100% {
        transform: rotate(-28deg);
      }
      58%,
      72% {
        transform: rotate(0);
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .wall_wrap[data-placing="true"] .wall-group_wrap,
      .wall_wrap[data-placing="true"] .wall-group_stroke {
        animation: none;
      }
      .wall-group_stroke {
        transition: none;
      }
    }
  }
</style>
