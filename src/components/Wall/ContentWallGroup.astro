---
import { Trash, ArrowDownRight } from "@lucide/astro";
import Button from "@/components/Button.astro";
import Heading from "@/components/Typography/Heading.astro";
interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
}
const { render = true } = Astro.props;
---

{
  render && (
    <section class="wall-group_wrap" data-group-id="">
      <div class="wall-group_header">
        <span class="wall-group_number" aria-hidden="true" data-group-number />
        <Heading tag="h2" variant="inherit" class="wall-group_title">
          <span data-group-name />
        </Heading>
        <span class="wall-group_count" data-group-count />
        <Button
          class="wall_icon wall-group_delete"
          data-action="delete-group"
          aria-label="Borrar grupo"
          title="Borrar grupo"
        >
          <Trash />
        </Button>
      </div>
      <button
        type="button"
        class="wall-group_destination"
        data-action="place"
        hidden
      >
        <>
          <span>Colocar aqu&iacute;</span>
          <ArrowDownRight />
        </>
      </button>
      <div class="wall-group_list" data-drop="group" role="list" />
      <div class="wall-group_empty" data-group-empty>
        <>
          <span class="wall-group_dash" aria-hidden="true" />
          <span>Sin tareas</span>
        </>
      </div>
    </section>
  )
}

<style is:global>
  @layer components {
    .wall-group_wrap {
      --group-accent: var(--wall-red);
      position: relative;
      min-width: 0;
      align-self: start;
      border-top: 0.25rem solid var(--group-accent);
      &:nth-child(3n + 2) {
        --group-accent: var(--wall-ink);
      }
      &:nth-child(3n + 3) {
        --group-accent: #5c8c80;
      }
    }
    .wall-group_header {
      display: flex;
      gap: 0.625rem;
      align-items: center;
      min-height: 5rem;
    }
    .wall-group_number {
      font-size: 0.65rem;
      color: var(--wall-muted);
      align-self: center;
      font-family: monospace;
    }
    .wall-group_title {
      font-size: 1.125rem;
      font-weight: 700;
      font-family: Arial, sans-serif;
      margin: 0;
      line-height: 1.2;
      flex: 1;
      overflow-wrap: anywhere;
    }
    .wall-group_count {
      font-size: 0.75rem;
      font-family: monospace;
      color: var(--wall-muted);
    }
    .wall-group_list {
      display: flex;
      flex-direction: column;
      gap: 0.875rem;
      min-height: 8rem;
      padding-bottom: 1rem;
    }
    .wall-group_empty {
      position: absolute;
      top: 7rem;
      left: 0;
      right: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
      pointer-events: none;
      color: var(--wall-muted);
      font-size: 0.75rem;
    }
    .wall-group_dash {
      width: 1.5rem;
      height: 0.125rem;
      background: var(--wall-line);
    }
    .wall-group_destination {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      padding: 0.65rem 0.875rem;
      font-size: 0.8rem;
      background: var(--wall-mint);
      border: 0.0625rem dashed var(--wall-ink);
      margin-bottom: 0.75rem;
      & svg {
        width: 1.1rem;
        height: 1.1rem;
      }
    }
    .wall_wrap[data-placing="true"] .wall-group_wrap {
      outline: 0.0625rem dashed var(--group-accent);
      outline-offset: 0.375rem;
      animation: wall-group-nudge 2.4s ease-in-out infinite;
      &:nth-child(3n + 2) {
        animation-delay: 0.2s;
      }
      &:nth-child(3n + 3) {
        animation-delay: 0.4s;
      }
    }
    .wall_wrap[data-placing="true"] .wall-group_empty {
      top: 10rem;
    }
    @keyframes wall-group-nudge {
      0%,
      100% {
        transform: translateY(0);
      }
      12%,
      28% {
        transform: translateY(-0.25rem);
      }
      20%,
      36% {
        transform: translateY(0);
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .wall_wrap[data-placing="true"] .wall-group_wrap {
        animation: none;
      }
    }
  }
</style>
